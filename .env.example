# Copy to .env and fill in. With nothing set, the app runs on built-in sample data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_TMDB_KEY=
# LiveKit URL (wss://your-project.livekit.cloud). Keys live in the Supabase edge function, not here.
EXPO_PUBLIC_LIVEKIT_URL=

# Server-only values — set these as Supabase Edge Function secrets, never in this file / app bundle:
# supabase secrets set LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=... LIVEKIT_URL=wss://...
