{
  "expo": {
    "name": "WKU+",
    "slug": "wku-plus",
    "scheme": "wkuplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#89C4E6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "et.edu.wku.plus",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WKU+ uses your location to show how far campus places are and to track deliveries.",
        "NSCameraUsageDescription": "WKU+ TV uses your camera for live video.",
        "NSMicrophoneUsageDescription": "WKU+ TV uses your microphone for live video."
      }
    },
    "android": {
      "package": "et.edu.wku.plus",
      "adaptiveIcon": {
        "backgroundColor": "#89C4E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WKU+ uses your location to show how far campus places are and to track deliveries."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "expo-video"
      ,"expo-notifications"
      ,[
        "expo-image-picker",
        { "photosPermission": "WKU+ lets you choose product and shop photos for Gebeya." }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
